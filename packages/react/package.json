{
  "name": "@auronui/react",
  "version": "1.8.0",
  "description": "React 85+ components with full visual and functional parity with @auronui/vue",
  "type": "module",
  "license": "MIT",
  "homepage": "https://darkknight1992.github.io/auronui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DarkKnight1992/auronui.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/DarkKnight1992/auronui/issues"
  },
  "keywords": [
    "react",
    "components",
    "ui",
    "component-library",
    "heroui",
    "radix-ui",
    "tailwindcss",
    "accessible",
    "typescript",
    "auron"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/style.css",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/cjs/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@internationalized/date": ">=3.0.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "tailwindcss": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "dependencies": {
    "@auronui/styles": "workspace:*",
    "@iconify/react": "^5.0.0",
    "@radix-ui/react-accordion": "^1.2.0",
    "@radix-ui/react-context-menu": "^2.2.0",
    "@radix-ui/react-menubar": "^1.1.0",
    "@radix-ui/react-navigation-menu": "^1.2.0",
    "@radix-ui/react-scroll-area": "^1.2.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-toolbar": "^1.1.0",
    "@tanstack/react-table": "^8.20.0",
    "@tanstack/react-virtual": "^3.13.0",
    "framer-motion": "^12.0.0",
    "react-aria": "^3.35.0",
    "react-aria-components": "^1.5.0",
    "react-hook-form": "^7.54.0",
    "react-stately": "^3.33.0",
    "tailwind-merge": "3.5.0",
    "tailwind-variants": "3.2.2"
  },
  "devDependencies": {
    "@auronui/standard": "workspace:*",
    "@auronui/vitest": "workspace:*",
    "@chialab/vitest-axe": "0.19.1",
    "@internationalized/date": "^3.12.1",
    "@tailwindcss/vite": "4.2.2",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^25.6.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "axe-core": "^4.11.2",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "6.0.2",
    "vite": "^8.0.8",
    "vite-plugin-dts": "4.5.4",
    "vitest": "4.1.4"
  }
}
